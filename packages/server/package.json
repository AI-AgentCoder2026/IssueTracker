{
  "name": "@tracker/server",
  "version": "0.1.0",
  "private": false,
  "description": "Issue tracker API server: lifecycle, collaboration, RBAC, dashboards, SLA timelines and GitLab sync.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "dev": "node --watch --experimental-strip-types --disable-warning=ExperimentalWarning src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/db/cli.ts up",
    "seed": "node --experimental-strip-types --disable-warning=ExperimentalWarning src/db/seed.ts",
    "test": "node --test --experimental-strip-types --disable-warning=ExperimentalWarning \"test/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.1",
    "@fastify/multipart": "^9.0.1",
    "@fastify/rate-limit": "^10.2.1",
    "@fastify/static": "^10.1.5",
    "@fastify/websocket": "^11.0.1",
    "@tracker/shared": "*",
    "fastify": "^5.2.0",
    "fastify-plugin": "^5.0.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2"
  }
}
