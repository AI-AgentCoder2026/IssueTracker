# Copy to `.env` and adjust. Never commit the real file.
# Every variable has a working default; set only what you need.

NODE_ENV=development
PORT=4000
HOST=0.0.0.0
LOG_LEVEL=info

# Where the SQLite database, uploads and generated secrets live.
DATA_DIR=./data
# DATABASE_FILE=./data/tracker.db
# UPLOAD_DIR=./data/uploads

# Upload ceiling in bytes (25 MB).
MAX_UPLOAD_BYTES=26214400

# Session lifetime (7 days).
SESSION_TTL_SECONDS=604800

# Comma-separated allow-list. Empty reflects the request origin, which is fine
# for local development but should be pinned behind a reverse proxy.
# CORS_ORIGINS=https://tracker.example.com

# Serve the built SPA from the API process.
SERVE_WEB_CLIENT=true
# WEB_CLIENT_DIR=../web/dist

# Background jobs: SLA evaluation, stale archiving, GitLab sync, outbox drain.
ENABLE_SCHEDULER=true

# Set to true only when running behind a reverse proxy you control.
TRUST_PROXY=false

# Seed an administrator on first boot. The first registered account becomes an
# instance admin automatically, so this is only needed for unattended setup.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=change-this-to-a-long-random-value
